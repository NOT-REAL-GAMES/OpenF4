{
  "$schema": "https://raw.githubusercontent.com/microsoft/vcpkg-tool/main/docs/vcpkg.schema.json",
  "name": "openf4",
  "version-string": "0.1.0",
  "dependencies": [
    "assimp",
    "glm",
    {
      "name": "imgui",
      "features": ["docking-experimental", "sdl3-binding", "vulkan-binding"]
    },
    "imguizmo",
    "joltphysics",
    "libgeotiff",
    "lz4",
    {
      "name": "sdl3",
      "features": ["vulkan"]
    },
    "shaderc",
    "stb",
    "vulkan-memory-allocator",
    "zlib"
  ]
}
